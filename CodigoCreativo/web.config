<?xml version="1.0" encoding="UTF-8"?>
<!-- codigocreativo.tech — IIS (Plesk Windows). Requiere el módulo URL Rewrite (viene con Plesk). -->
<configuration>
  <system.webServer>

    <!-- App_Data guarda la configuración SMTP que genera el pipeline: nunca se sirve -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <remove segment="App_Data" />
          <add segment="App_Data" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <directoryBrowse enabled="false" />

    <!-- HTTPS y dominio sin www (coincide con el canonical) -->
    <rewrite>
      <rules>
        <rule name="Bloquear deploy" stopProcessing="true">
          <match url="^deploy(/|$)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="Forzar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
          </conditions>
          <action type="Redirect" url="https://codigocreativo.tech/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
        <rule name="Sin www" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.codigocreativo\.tech$" />
          </conditions>
          <action type="Redirect" url="https://codigocreativo.tech/{R:1}" redirectType="Permanent" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>

    <!-- Tipos MIME que IIS no trae por defecto (se quitan antes para no duplicarlos) -->
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".mp4" />
      <mimeMap fileExtension=".mp4" mimeType="video/mp4" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <!-- HTML, CSS y JS se revalidan en cada visita (304 si no cambiaron): los módulos ES se
           importan sin versión en la URL y una caché larga mezclaría archivos viejos y nuevos. -->
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Strict-Transport-Security" value="max-age=31536000" />
      </customHeaders>
    </httpProtocol>

  </system.webServer>

  <!-- Imágenes, logos y videos: 30 días de caché -->
  <location path="assets">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <!-- El formulario responde JSON también en errores (422, 429, 502): que IIS no lo reemplace por su página de error -->
  <location path="api">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>
</configuration>
