<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        LaunchTheme: lo que se ve entre que se toca el icono y que Flutter
        dibuja su primer frame. Es el fondo de marca con el isotipo centrado.
    -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!--
        NormalTheme: el fondo de la ventana ya con el motor corriendo, detras
        de la interfaz de Flutter.

        Va el color de marca y NO `?android:colorBackground`, que es lo que
        traia la plantilla. Con el tema del sistema en claro, ese atributo es
        BLANCO: entre que se apaga el LaunchTheme oscuro y que Flutter pinta su
        primer frame se colaba un destello blanco, y la app arranca en oscuro.
        Es el mismo `#0B0F1A` del splash de Dart, asi los tres momentos del
        arranque son el mismo color y no se ve ni un parpadeo.
    -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
