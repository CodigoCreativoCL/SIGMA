# Copiar a ML/.env y completar. ML/.env NO se versiona (.gitignore).
# Azure ML (registro de modelos): con `az login` hecho basta esta URI.
MLFLOW_TRACKING_URI=azureml://eastus2.api.azureml.ms/mlflow/v1.0/subscriptions/af092419-a7e8-453a-b29a-8ef889109f66/resourceGroups/SIGMA/providers/Microsoft.MachineLearningServices/workspaces/SIGMA_AI
# La API de SIGMA
SIGMA_API=http://localhost/SIGMA/Servicio/API
# Custom Vision: el recurso de ENTRENAMIENTO (sin sufijo -Prediction)
CV_TRAINING_ENDPOINT=https://sigmavisionmodel.cognitiveservices.azure.com/
CV_TRAINING_KEY=PENDIENTE
# customvision.ai > proyecto > engranaje > Project Id
CV_PROJECT_ID=PENDIENTE
# Para publicar la iteracion: el id del recurso de prediccion
CV_PREDICTION_RESOURCE_ID=/subscriptions/af092419-a7e8-453a-b29a-8ef889109f66/resourceGroups/SIGMA/providers/Microsoft.CognitiveServices/accounts/SIGMAVISIONMODEL-Prediction
CV_ITERATION_NAME=sigma-vision
