<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=301879
  -->
<configuration>
	<appSettings>
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />

		<!-- Declaro la conexión a la base de datos -->
		<add key="DefaultConnectionStringName" value="Data Source=sql5112.site4now.net;Initial Catalog=db_acd593_sigma;User Id=db_acd593_sigma_admin;Password=Codigo2003$;Encrypt=True;TrustServerCertificate=True;" />

		<!-- Key from Jason Web Token -->
		<add key="JWT_SECRET_KEY" value="!ABCDEFGHIJKLMNOPQRSTUVWXYZ123456***" />
		<!-- Tiempo de expiracion del token en minutos, se deja establecido en 8 horas-->
		<add key="JWT_EXPIRE_MINUTES" value="480" />

		<add key="JWT_AUDIENCE_TOKEN" value="http://localhost/SIGMA/Servicio/API" />
		<add key="JWT_ISSUER_TOKEN" value="http://localhost/SIGMA/Servicio/API" />

		<!-- ================================================================
		     AZURE BLOB STORAGE

		     El SAS es una CREDENCIAL. Vive solo aca: si la web hablara con
		     Azure directo, estaria tambien en el servidor web y rotarla
		     obligaria a tocar dos configuraciones en vez de una.

		     El token que entrego el portal es de CUENTA COMPLETA
		     (sp=rwdlacupiytfx, srt=sco): permite leer, escribir, borrar y
		     listar en blob, cola, tabla y archivos. Para lo que este modulo
		     hace basta un SAS acotado al contenedor con permisos rwd.
		     Ver la nota en el MD de estado.

		     Vence el 2027-03-01. Ese dia las subidas empiezan a fallar con
		     403 y el mensaje de Azure no dice que el token expiro.
		     ================================================================ -->
		<add key="AzureBlobEndpoint" value="https://sigmacodigocreativo.blob.core.windows.net" />
		<add key="AzureBlobSas" value="sv=2026-02-06&amp;ss=bfqt&amp;srt=sco&amp;sp=rwdlacupiytfx&amp;se=2027-03-01T21:24:18Z&amp;st=2026-09-01T14:09:18Z&amp;spr=https&amp;sig=yOUQhoeX%2FEc%2Bd7dCGiIcLac84srbm%2BknijYcf%2B68c%2Fs%3D" />
		<add key="AzureBlobContenedor" value="sigma" />

		<!-- La clave con la que la web se identifica ante /archivo. Sin ella
		     configurada el endpoint NO se abre: se cierra. -->
		<add key="ServiciosApiKey" value="sigma-servicios-2026-b7f3a91c4e" />

		<!-- ================================================================
		     AZURE MACHINE LEARNING · Investigacion SIGMA AI (bloque 245)

		     La API solo LEE el area de trabajo (modelos registrados,
		     experimentos, corridas). Nada de esto se factura: lo que cuesta
		     en Azure ML es el computo, y no se crea ninguno. El entrenamiento
		     corre en el equipo de quien entrena (ML/entrenar_falla.py) y la
		     puntuacion dentro de esta API (Utils/PuntuadorFalla.cs).

		     Se autentica con una entidad de servicio (Entra ID > App
		     registrations) con el rol «AzureML Data Scientist» sobre el area
		     de trabajo. Los valores los pone quien administra la suscripcion,
		     directamente aqui; NO viajan por chat ni por correo. Mientras
		     alguno diga PENDIENTE la API responde "no configurado" y la
		     pantalla lo muestra tal cual.
		     ================================================================ -->
		<add key="AzureML.TenantId" value="e3430037-16f9-4613-8257-37c436e01a82" />
		<add key="AzureML.ClientId" value="TU_CLIENT_ID_PENDIENTE" />
		<add key="AzureML.ClientSecret" value="TU_CLIENT_SECRET_PENDIENTE" />
		<add key="AzureML.SubscriptionId" value="af092419-a7e8-453a-b29a-8ef889109f66" />
		<add key="AzureML.ResourceGroup" value="SIGMA" />
		<add key="AzureML.Workspace" value="SIGMA_AI" />
		<add key="AzureML.Region" value="eastus2" />
		<!-- Los artefactos del registro de modelos viven en la cuenta de
		     almacenamiento del area de trabajo (la misma de AzureBlobSas), en
		     este contenedor (datastore workspaceartifactstore). Con eso la API
		     baja y verifica el .onnx registrado SIN entidad de servicio. -->
		<add key="AzureML.ContenedorArtefactos" value="azureml" />

		<!-- SIGMA VISION · Azure Custom Vision, nivel F0 (gratis: 2 proyectos,
		     5.000 imagenes, 1 h de entrenamiento y 10.000 predicciones al mes).
		     Se usa con claves, no con Entra ID. La API solo PREDICE (clave de
		     prediccion); entrenar, publicar y exportar lo hace ML/entrenar_vision.py
		     con la clave de entrenamiento, fuera de la API. Los valores los pone
		     quien administra la suscripcion, aqui; nunca por chat ni correo. -->
		<add key="CustomVision.PredictionEndpoint" value="PENDIENTE" />
		<add key="CustomVision.PredictionKey" value="PENDIENTE" />
		<add key="CustomVision.ProjectId" value="PENDIENTE" />
		<add key="CustomVision.IterationName" value="sigma-vision" />


		<add key="Username" value="Sigma" />
		<add key="Password" value="1" />


	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" maxUrlLength="2048" maxRequestLength="204800" maxQueryStringLength="80000" executionTimeout="86400" />
	</system.web>
	<system.webServer>
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="524288000" />
			</requestFiltering>
		</security>
		<!-- WebDAV se saca, y no es un capricho.

		     IIS trae el modulo WebDAV activado, y ese modulo se queda con los
		     DELETE y los PUT ANTES de que lleguen a Web API. El sintoma es un
		     404 de IIS con "Controlador: StaticFile" y la ruta fisica del
		     disco: la peticion nunca entro a la aplicacion.

		     Con esto DELETE /sesion (HU-003, cerrar sesion) nunca habia
		     funcionado, ni DELETE /dispositivos, ni ningun PUT. Se detecto el
		     04-09-2026 probando la baja del token FCM.

		     Hay que quitarlo en los dos sitios: el modulo intercepta la
		     peticion y el handler la atiende. Sacar solo uno no alcanza. -->
		<modules runAllManagedModulesForAllRequests="false">
			<remove name="WebDAVModule" />
		</modules>
		<handlers>
			<remove name="WebDAV" />
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>
	</system.webServer>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Antlr3.Runtime" publicKeyToken="eb42632606e9261f" />
				<bindingRedirect oldVersion="0.0.0.0-3.5.0.2" newVersion="3.5.0.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" culture="neutral" publicKeyToken="30ad4fe6b2a6aeed" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Optimization" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="1.0.0.0-1.1.0.0" newVersion="1.1.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Web.Infrastructure" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-2.0.0.0" newVersion="2.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
				<bindingRedirect oldVersion="1.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Web.Http" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Net.Http.Formatting" publicKeyToken="31bf3856ad364e35" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="Microsoft.Bcl.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
