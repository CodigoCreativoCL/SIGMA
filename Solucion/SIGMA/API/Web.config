<?xml version="1.0" encoding="utf-8"?>
<!--
  Para obtener más información sobre cómo configurar la aplicación ASP.NET, visite
  https://go.microsoft.com/fwlink/?LinkId=301879
  -->
<configuration>
	<appSettings>
		<add key="webpages:Version" value="3.0.0.0" />
		<add key="webpages:Enabled" value="false" />
		<add key="ClientValidationEnabled" value="true" />
		<add key="UnobtrusiveJavaScriptEnabled" value="true" />

		<!-- Declaro la conexión a la base de datos -->
		<add key="DefaultConnectionStringName" value="Data Source=sql5112.site4now.net;Initial Catalog=db_acd593_sigma;User Id=db_acd593_sigma_admin;Password=Codigo2003$;Encrypt=True;TrustServerCertificate=True;" />

		<!-- Key from Jason Web Token -->
		<add key="JWT_SECRET_KEY" value="!ABCDEFGHIJKLMNOPQRSTUVWXYZ123456***" />
		<!-- Tiempo de expiracion del token en minutos, se deja establecido en 8 horas-->
		<add key="JWT_EXPIRE_MINUTES" value="480" />

		<add key="JWT_AUDIENCE_TOKEN" value="http://localhost/SIGMA/Servicio/API" />
		<add key="JWT_ISSUER_TOKEN" value="http://localhost/SIGMA/Servicio/API" />

		<!-- ================================================================
		     AZURE BLOB STORAGE

		     El SAS es una CREDENCIAL. Vive solo aca: si la web hablara con
		     Azure directo, estaria tambien en el servidor web y rotarla
		     obligaria a tocar dos configuraciones en vez de una.

		     El token que entrego el portal es de CUENTA COMPLETA
		     (sp=rwdlacupiytfx, srt=sco): permite leer, escribir, borrar y
		     listar en blob, cola, tabla y archivos. Para lo que este modulo
		     hace basta un SAS acotado al contenedor con permisos rwd.
		     Ver la nota en el MD de estado.

		     Vence el 2027-03-01. Ese dia las subidas empiezan a fallar con
		     403 y el mensaje de Azure no dice que el token expiro.
		     ================================================================ -->
		<add key="AzureBlobEndpoint" value="https://sigmacodigocreativo.blob.core.windows.net" />
		<add key="AzureBlobSas" value="sv=2026-02-06&amp;ss=bfqt&amp;srt=sco&amp;sp=rwdlacupiytfx&amp;se=2027-03-01T21:24:18Z&amp;st=2026-09-01T14:09:18Z&amp;spr=https&amp;sig=yOUQhoeX%2FEc%2Bd7dCGiIcLac84srbm%2BknijYcf%2B68c%2Fs%3D" />
		<add key="AzureBlobContenedor" value="sigma" />

		<!-- La clave con la que la web se identifica ante /archivo. Sin ella
		     configurada el endpoint NO se abre: se cierra. -->
		<add key="ServiciosApiKey" value="sigma-servicios-2026-b7f3a91c4e" />

		<add key="Username" value="Sigma" />
		<add key="Password" value="1" />


	</appSettings>
	<system.web>
		<compilation debug="true" targetFramework="4.8" />
		<httpRuntime targetFramework="4.8" maxUrlLength="2048" maxRequestLength="204800" maxQueryStringLength="80000" executionTimeout="86400" />
	</system.web>
	<system.webServer>
		<security>
			<requestFiltering>
				<requestLimits maxAllowedContentLength="524288000" />
			</requestFiltering>
		</security>
		<handlers>
			<remove name="ExtensionlessUrlHandler-Integrated-4.0" />
			<remove name="OPTIONSVerbHandler" />
			<remove name="TRACEVerbHandler" />
			<add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
		</handlers>
	</system.webServer>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
