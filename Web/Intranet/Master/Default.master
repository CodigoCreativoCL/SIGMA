<%@ Master Language="C#" CodeFile="Default.master.cs" Inherits="Master_Default" %>

<%@ Register TagPrefix="UserControl" TagName="MenusLateral" Src="~/View/Comun/Controls/MenusLateral.ascx" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>SIGMA</title>
    <meta name="theme-color" content="#0B0F1A" />
    <%-- Favicon. Dos cosas que lo tenian caido:
         1. Sin rel="icon" el navegador ignora el link por completo.
         2. Dentro de un <head runat="server"> los bloques <%= %> no se
            evaluan de forma confiable y el href sale literal.
         Con runat="server" en el propio link, HtmlLink resuelve el ~/
         del lado del servidor y funciona a cualquier profundidad. --%>
    <link id="favicon" rel="icon" type="image/svg+xml" href="~/Imagen/sigma-favicon.svg" runat="server" />

    <!-- Bootstrap Css -->
    <link href="../Css/Adminto/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />

    <!-- Icons Css -->
    <link href="../Css/Adminto/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

    <!-- App Css-->
    <link href="../Css/Adminto/assets/css/app.min.css" rel="stylesheet" type="text/css" />


    <!-- AjaxProgress CSS -->
    <link href="../Css/AjaxProgress/cssUpdateProgress.css" rel="stylesheet" />
    <link href="../Css/AjaxProgress/UpdateProgress.css?vrs=2" rel="stylesheet" />

    <!-- Default CSS -->
    <link href="../Css/Default/Default.css?vrs=4" rel="stylesheet" />

    
    <!-- LookAndFeel CSS -->
    <link href="../Css/LookAndFeel/Default.css?vrs=1" rel="stylesheet" />

    <%-- La carpeta Css/LookAndFeel/v2 (relook de FacilityGes) YA NO SE
         CARGA. Sus siete hojas quedaron repartidas asi:
           01-Variables -> tokens en sigma-brand.css
           02-Sidebar   -> sigma-layout.css
           03-Botones   -> estaba vacia
           04-Grid      -> estaba vacia
           05-Telerik   -> sigma-components.css
           06-General   -> sigma-components.css
           07-Topbar    -> sigma-layout.css
         Los archivos siguen en disco por si hay que volver atras. --%>

    <!-- Material Design Icons 7.4.47, completo y fuera de Adminto.
         El icons.min.css de Adminto declara la familia pero NO trae ni un
         glifo: solo los modificadores. Con eso, TODO icono mdi del sitio
         -incluidos los del menu lateral- salia vacio. -->
    <link href="../Css/LookAndFeel/mdi/css/materialdesignicons.min.css?vrs=7" rel="stylesheet" />

    <!-- SIGMA: tokens de marca y tipografia Sora -->
    <link href="../Css/LookAndFeel/sigma-brand.css?vrs=3" rel="stylesheet" />

    <!-- SIGMA: componentes (Telerik, formularios, modales) -->
    <link href="../Css/LookAndFeel/sigma-components.css?vrs=8" rel="stylesheet" />
    <link href="../Css/LookAndFeel/sigma-avatares.css?vrs=2" rel="stylesheet" />
    <!-- SIGMA: estructura (sidebar, topbar, area de trabajo) -->
    <link href="../Css/LookAndFeel/sigma-layout.css?vrs=5" rel="stylesheet" />

    <!-- Telerik CSS -->
    <link href="../Css/UI/Telerik/Bootstrap/Grid.css?vrs=6" rel="stylesheet" />
    <link href="../Css/UI/Telerik/Bootstrap/RadComboBox.css?vrs=1" rel="stylesheet" />

    <!-- WebControls CSS -->
    <link href="../Css/UI/WebControls/calendar/CSS/Classic.css?vrs=1" rel="stylesheet" />
    <link href="../Css/UI/WebControls/Button.css?vrs=3" rel="stylesheet" />
    <link href="../Css/UI/WebControls/TextBox.css?vrs=1" rel="stylesheet" />
    <link href="../Css/UI/WebControls/CheckBox.css?vrs=1" rel="stylesheet" />

    <!-- SweetAlert CSS -->
    <link href="../Css/SweetAlert/sweetalert.css?vrs=7" rel="stylesheet" />
    <link href="../Css/SweetAlert/sweetalert2.min.css?vrs=7" rel="stylesheet" />


    <asp:ContentPlaceHolder ID="cphHeder" runat="server">
        <style>
            /* Forzar que los botones (Maximizar/Cerrar, etc.) siempre queden en una sola fila,
       sin depender del float/list-style del skin base embebido en Telerik.Web.UI */
            .RadWindow_Bootstrap .rwControlButtons,
            .RadWindow_Bootstrap .rwTable .rwControlButtons {
                display: flex !important;
                flex-flow: row nowrap !important;
                align-items: center;
                list-style: none;
                white-space: nowrap;
            }

                .RadWindow_Bootstrap .rwControlButtons li,
                .RadWindow_Bootstrap .rwTable .rwControlButtons li {
                    display: inline-block !important;
                    float: none !important;
                    flex: 0 0 auto;
                }
        </style>
    </asp:ContentPlaceHolder>

    <link href="../Css/LookAndFeel/sigma-indicators.css?vrs=1" rel="stylesheet" />
    <link href="../Css/LookAndFeel/sigma-notificaciones.css?vrs=18" rel="stylesheet" />
    <link href="../Css/LookAndFeel/sigma-toast.css?vrs=1" rel="stylesheet" />
    <link href="../Css/LookAndFeel/sigma-dialog.css?vrs=8" rel="stylesheet" />
    <link href="../Css/LookAndFeel/sigma-listas.css?vrs=14" rel="stylesheet" />
    <%-- Los botones del sitio. Va DESPUES de todas las demas: redefine
         reglas de Grid.css y Button.css que traen !important, y para
         ganarles hay que cargarla al final. --%>
    <link href="../Css/LookAndFeel/sigma-botones.css?vrs=16" rel="stylesheet" />
    <%-- El calendario de SIGMA: reemplaza el panel de PopCalendar. --%>
    <link href="../Css/LookAndFeel/sigma-calendario.css?vrs=3" rel="stylesheet" />
</head>

<body data-sidebar="dark">
    <form id="form1" runat="server">

        <%-- POR QUE ESTE SCRIPT VIVE ACA Y NO EN EL <head>

             Estaba en el head y tumbaba el sitio entero con "La coleccion de
             controles no puede modificarse porque el control contiene bloques
             de codigo". Con <head runat="server">, cualquier control que se
             agregue a la cabecera -y Telerik agrega los suyos- choca contra un
             <%= %> presente ahi.

             Es la misma regla que ya estaba escrita doce lineas mas arriba,
             para el favicon. Dentro del form no hay problema. --%>
        <%-- El contador se refresca solo: cada minuto pregunta si hay algo
             nuevo y, del otro lado, ese mismo llamado dispara el detector si
             al freno de la base le toca. Asi el modulo avisa sin depender de
             que alguien apriete un boton. --%>
        <script type="text/javascript" src="<%=ResolveUrl("~/Js/sigma-alertas.js") %>?vrs=2"></script>
        <script type="text/javascript">
            sigmaAlertas.iniciar('<%=ResolveUrl("~/WebService/WsAlertas.asmx") %>', 60,
                                 '<%=ResolveUrl("~/Imagen/sigma-ai/") %>');
        </script>

        <script type="text/javascript">
        /* ABRIR EL REGISTRO DE UNA NOTIFICACION

           Se abre en la misma ventana modal que usa el resto del sitio, y no
           navegando: quien mira las notificaciones esta EN otra pantalla, y
           sacarlo de ahi para ver un aviso le hace perder lo que estaba
           haciendo. Al cerrar la ficha vuelve a donde estaba.

           Sirve para cualquier tipo de alerta porque el destino viene en el
           dato -alt_ficha_link y su id-, no en el javascript. */
        function abrirNotificacion(url, query, id) {
            /* Abrirla es haberla leido: el contador baja sin pedir nada mas.
               Va ANTES de mostrar la ventana, porque despues el foco se lo
               lleva el modal y el usuario ya no vuelve a mirar la campana. */
            if (id && window.sigmaAlertas) sigmaAlertas.leer(id);

            /* El modal de SIGMA, igual que en el resto del sitio. La
               comprobacion de existencia ya no hace falta: el componente se
               crea al primer uso, no es un control que pueda no haberse
               renderizado. */
            SigmaModal.open({
                url: query ? url + "?query=" + query : url,
                title: 'Detalle de la alerta',
                width: 1000,
                initialHeight: 680
            });

            return false;
        }
    </script>

        <!--Inicio ScriptManager-->
        <div>
            <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" AsyncPostBackTimeout="3600"
                EnableScriptGlobalization="true" EnableScriptLocalization="true">
                <Scripts>
                    <%-- EL ORDEN IMPORTA. jQuery UI es un plugin de jQuery:
                         lo primero que hace al cargarse es leer la variable
                         jQuery. Estaba declarado ANTES que jQuery, asi que
                         moria en su linea 19 con "jQuery is not defined" y
                         el sitio se quedaba sin jQuery UI en todas las
                         paginas. jQuery va primero. --%>
                    <asp:ScriptReference Path="~/Js/jquery-1.9.1.js" />
                    <%-- $.browser, que jQuery 1.9 quito y jQuery UI 1.8 usa. Tiene
                             que ir ENTRE los dos. --%>
                        <asp:ScriptReference Path="~/Js/jquery-browser-shim.js" />
                        <asp:ScriptReference Path="~/Js/jquery-ui-1.8rc3.custom.min.js" />
                    <asp:ScriptReference Path="~/Js/Library.js?vrs=9" />
                    <%-- Define `.modal()`, que ClientAlert necesita y Bootstrap JS no
                         esta para dar. Va DESPUES de Library.js, que es quien lo usa. --%>
                    <asp:ScriptReference Path="~/Js/sigma-alerta-modal.js" />
                        <asp:ScriptReference Path="~/Js/sigma-popover.js?vrs=1" />
                    <asp:ScriptReference Path="~/Js/highcharts/highcharts.js" />
                    <asp:ScriptReference Path="~/Js/highcharts/highchartTable-min.js" />
                    <asp:ScriptReference Path="~/Css/AjaxProgress/jsUpdateProgress.js" />
                    <asp:ScriptReference Path="~/Css/UI/WebControls/calendar/PopCalendarFunctionsAjaxNet.js" />
                    <asp:ScriptReference Path="~/Css/SweetAlert/sweetalert2.min.js" />
                </Scripts>
            </asp:ScriptManager>

            <!--Inicio AjaxProgress-->
            <asp:Panel ID="panelUpdateProgress" runat="server" CssClass="updateProgress">
                <asp:UpdateProgress ID="UpdateProg1" DisplayAfter="0" runat="server">
                    <ProgressTemplate>
                        <div class="up-card">
                            <div class="up-brand-stage" aria-hidden="true">
                                <svg class="up-vector-trails" viewBox="0 0 160 150">
                                    <path d="M52 124C38 96 68 87 57 57C51 41 58 25 71 13" />
                                    <path d="M82 128C68 102 92 89 83 65C77 48 85 31 97 18" />
                                    <path d="M108 123C98 101 121 91 113 69C107 52 116 40 126 30" />
                                </svg>
                                <span class="up-particle is-1"></span><span class="up-particle is-2"></span>
                                <span class="up-particle is-3"></span><span class="up-particle is-4"></span>
                                <span class="up-particle is-5"></span><span class="up-particle is-6"></span>
                                <img class="up-logo" src="<%=ResolveUrl("~/Imagen/sigma-isotipo-gradient.svg") %>" alt="" />
                            </div>
                            <div class="up-text-area">
                                <span class="up-label-caps">PROCESANDO EN SIGMA</span>
                                <div class="up-timer">
                                    Tiempo transcurrido:
                                    <span class="up-bold">
                                        <label id="lblModalMinutos">0</label>
                                        Minutos</span>
                                    <span class="up-bold">
                                        <label id="lblModalSegundos">0</label>
                                        Segundos</span>
                                </div>
                            </div>
                            <div class="up-progress-track">
                                <div class="up-progress-fill"></div>
                            </div>
                        </div>
                    </ProgressTemplate>
                </asp:UpdateProgress>
            </asp:Panel>
            <ajaxToolkit:ModalPopupExtender ID="ModalProgress" runat="server" TargetControlID="panelUpdateProgress"
                BackgroundCssClass="modalBackground" PopupControlID="panelUpdateProgress" />
            <!--Fin AjaxProgress-->
        </div>
        <!--Fin ScriptManager-->

        <!-- Begin page -->
        <div id="wrapper">


            <div class="navbar-custom">


                <div class="logo-box">
                    <a href='<%=ResolveUrl("~/Default.aspx") %>' class="logo logo-light" title="SIGMA">
                        <span class="logo-lg">
                            <asp:Image ID="imgLogo" runat="server" AlternateText="SIGMA" ImageUrl="~/Imagen/sigma-logo-primary-dark.svg" />
                        </span>
                        <span class="logo-sm">
                            <asp:Image ID="imgLogoSm" runat="server" AlternateText="SIGMA" ImageUrl="~/Imagen/sigma-isotipo-white.svg" />
                        </span>
                    </a>
                    <a href='<%=ResolveUrl("~/Default.aspx") %>' class="logo logo-dark" title="SIGMA">
                        <span class="logo-lg">
                            <asp:Image ID="imgLogoClaro" runat="server" AlternateText="SIGMA" ImageUrl="~/Imagen/sigma-logo-horizontal-light.svg" />
                        </span>
                        <span class="logo-sm">
                            <asp:Image ID="imgLogoClaroSm" runat="server" AlternateText="SIGMA" ImageUrl="~/Imagen/sigma-isotipo-navy.svg" />
                        </span>
                    </a>
                </div>

                <div class="sg-topbar-left">
                    <button type="button" class="button-menu-mobile waves-effect" aria-label="Mostrar u ocultar el menu">
                        <i class="mdi mdi-menu"></i>
                    </button>

                    <!-- Buscador global.
                         PENDIENTE: aun no tiene destino. Se deja visible
                         porque es parte del diseño aprobado, pero hay que
                         conectarlo a una busqueda real antes de publicarlo. -->
                    <div class="sg-search">
                        <i class="mdi mdi-magnify sg-search-icon"></i>
                        <input type="search" id="txtBuscarGlobal" placeholder="Buscar..." aria-label="Buscar" disabled="disabled" />
                    </div>
                </div>

                <ul class="sg-topbar-right">

                    <!-- Cliente en sesion (HU-002).
                         Deja siempre a la vista con que empresa se esta
                         trabajando: sin esto, alguien que atiende a varias
                         no tiene como saber donde esta cargando los datos.
                         Solo es un enlace cuando hay mas de uno entre los
                         que elegir. -->
                    <li class="sg-cliente-actual">
                        <asp:PlaceHolder ID="phCliente" runat="server" />
                    </li>

                    <!-- NOTIFICACIONES

                         El numero era un "3" escrito a mano. Ahora sale de
                         Alerta: lo que el sistema detecto y esta persona
                         puede ver, segun su permiso.

                         El punto cuenta lo NO LEIDO, no lo abierto. Una
                         alerta puede seguir abierta y ya vista -el bodeguero
                         la leyo y esta pidiendo el repuesto-; si el contador
                         mostrara lo abierto no bajaria nunca y la gente
                         dejaria de mirarlo. -->
                    <!-- La ventana donde se abre el registro de la notificacion.
                         Una sola para todas: el tipo de alerta dice que ficha
                         cargar, asi que no hace falta una por modulo. -->

                    <li class="dropdown notification-list sg-notif">
                        <%-- La campana del kit de marca. Variante LIGHT porque la
                             barra superior es clara: la dark lleva el borde del
                             contador en navy y sobre blanco se ve un halo negro.

                             El numero se queda en HTML y no dentro del svg, para
                             que el servidor pueda actualizarlo sin tocar el
                             vector. --%>
                        <a class="dropdown-toggle sigma-notification sigma-notification--light"
                           data-toggle="dropdown" href="#" role="button"
                           aria-haspopup="false" aria-expanded="false"
                           runat="server" id="lnkCampana">
                            <img src='<%=ResolveUrl("~/Imagen/indicadores/sigma-notification-bell-light.svg") %>'
                                 alt="" aria-hidden="true" />
                            <asp:Literal ID="litBadgeAlertas" runat="server" />
                        </a>

                        <div class="dropdown-menu dropdown-menu-right sg-notif-panel" data-sg-notif-panel role="region" aria-label="Centro de notificaciones">

                            <%-- La lectura ocurre por WsAlertas y el panel se
                                 reconcilia con un GET AJAX. No hay LinkButton ni
                                 UpdatePanel: abrir la campana nunca postea el
                                 formulario de la pantalla que queda detrás. --%>

                            <div class="sg-notif-cabecera">
                                <div>
                                    <span class="sg-notif-eyebrow">Centro de notificaciones</span>
                                    <span class="titulo">Actividad que requiere atención</span>
                                    <span class="sg-notif-resumen"><asp:Literal ID="litPanelResumen" runat="server" /></span>
                                </div>
                                <div class="sg-notif-cabecera-acciones">
                                    <button type="button" ID="lnkLeerTodo" runat="server" class="sg-notif-leer"
                                        data-sg-notif-leer-todo>Marcar todo como leído</button>
                                    <button type="button" class="sg-notif-cerrar" data-sg-notif-dismiss
                                            aria-label="Cerrar centro de notificaciones">
                                        <i class="mdi mdi-close" aria-hidden="true"></i>
                                    </button>
                                </div>
                            </div>

                            <%-- FILTRAR SIN SALIR DEL PANEL

                                 La pregunta con la que se abre la campana es
                                 "¿qué hay que no haya mirado?", y hasta ahora
                                 había que deducirlo del fondo más tenue de
                                 cada fila y del punto de la derecha.

                                 No viaja al servidor: si cada fila está vista
                                 o no ya viaja en la fila, así que filtra el
                                 navegador y responde en el acto. --%>
                            <div class="sg-notif-filtros" role="group"
                                 aria-label="Filtrar notificaciones">
                                <button type="button" class="sg-notif-filtro is-activo"
                                        data-sg-notif-filtro="" aria-pressed="true">
                                    Todas <span class="n"></span></button>
                                <button type="button" class="sg-notif-filtro"
                                        data-sg-notif-filtro="0" aria-pressed="false">
                                    Sin ver <span class="n"></span></button>
                                <button type="button" class="sg-notif-filtro"
                                        data-sg-notif-filtro="1" aria-pressed="false">
                                    Vistas <span class="n"></span></button>
                            </div>

                            <div class="sg-notif-cuerpo">
                                <asp:Repeater ID="rptAlertas" runat="server"
                                    OnItemDataBound="rptAlertas_ItemDataBound">
                                    <ItemTemplate>
                                        <button type="button" ID="lnkItem" runat="server">
                                            <asp:Literal ID="litItem" runat="server" />
                                        </button>
                                    </ItemTemplate>
                                </asp:Repeater>

                                <!-- ============================================
                                     ESPACIO PARA EL SVG DE SIGMA

                                     Cuando no hay nada que avisar. Reemplace el
                                     contenido de .sg-notif-ilustracion por el
                                     <svg> de marca: el contenedor ya centra y
                                     limita a 140px de alto, asi que el svg solo
                                     necesita su viewBox y width/height al 100%.
                                     ============================================ -->
                                <asp:Panel ID="pnlSinAlertas" runat="server" Visible="false" CssClass="sg-notif-vacio">
                                    <div class="sg-notif-ilustracion">
                                        <img src='<%=ResolveUrl("~/Imagen/sigma-ai/sigma-ai-status-realtime.svg") %>'
                                             alt="" aria-hidden="true" />
                                    </div>
                                    <div class="sg-notif-vacio-titulo">Todo en orden</div>
                                    <div class="sg-notif-vacio-texto">
                                        No hay nada que revisar. Cuando algo se salga de sus
                                        umbrales, aparecerá acá.
                                    </div>
                                </asp:Panel>
                            </div>

                            <div class="sg-notif-pie">
                                <asp:HyperLink ID="lnkVerTodas" runat="server">
                                    Ver todas las notificaciones <i class="mdi mdi-arrow-right"></i>
                                </asp:HyperLink>
                            </div>
                        </div>
                    </li>

                    <!-- Accion principal.
                         PENDIENTE: apunta al inicio hasta que exista la
                         pantalla de creacion de orden de trabajo. -->
                    <li>
                        <a href='<%=ResolveUrl("~/Default.aspx") %>' class="sg-btn-primary">
                            <i class="mdi mdi-plus"></i>
                            <span>Nueva OT</span>
                        </a>
                    </li>

                    <li class="dropdown notification-list sg-account">
                        <a class="dropdown-toggle" data-toggle="dropdown" href="#" role="button" aria-haspopup="false" aria-expanded="false">
                            <asp:Image ID="imgUsuario" runat="server" AlternateText="Mi cuenta" CssClass="rounded-circle" />
                            <i class="mdi mdi-chevron-down"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right profile-dropdown">
                            <div class="dropdown-header noti-title">
                                <h6 class="text-overflow m-0">
                                    <%= SitioBase.Session.UsuarioNombre().Split(' ')[0] + " " +
                                        SitioBase.Session.UsuarioApellidoPaterno()
                                    %>
                                </h6>
                            </div>

                            <a href='<%=ResolveUrl("~/View/Comun/MiCuenta/MiCuenta.aspx") %>' class="dropdown-item notify-item">
                                <i class="mdi mdi-account-outline"></i>
                                <span>Mi Cuenta</span>
                            </a>

                            <div class="dropdown-divider"></div>

                            <asp:LinkButton ID="lnkCerrarSession" runat="server" OnClick="lnkCerrarSession_Click" CssClass="dropdown-item notify-item">
                                <i class="mdi mdi-logout"></i>
                                <span>Cerrar Sesion</span>
                            </asp:LinkButton>
                        </div>
                    </li>
                </ul>
            </div>
            <!-- end Topbar -->
            <!-- ========== Left Sidebar Start ========== -->
            <div class="left-side-menu">
                <div class="slimscroll-menu">

                    <!--- Sidemenu -->
                    <div id="sidebar-menu">
                        <ul class="metismenu" id="side-menu">
                            <UserControl:MenusLateral runat="server" ID="wucMenus" />
                        </ul>
                    </div>
                    <!-- End Sidebar -->

                    <!-- User box -->
                    <div class="user-box">
                        <div class="avatar-wrap">
                            <asp:Image ID="imgUsuarioLateral" runat="server" alt="user-img" CssClass="rounded-circle img-thumbnail avatar-md" />
                            <span class="avatar-status"></span>
                        </div>
                        <div class="user-info dropdown">
                            <a href="#" class="user-name dropdown-toggle d-block" data-toggle="dropdown" aria-expanded="false">
                                <%= SitioBase.Session.UsuarioNombre().Split(' ')[0] + " " +
                                    SitioBase.Session.UsuarioApellidoPaterno() + " " +
                                    SitioBase.Session.UsuarioApellidoMaterno()
                                %>
                            </a>
                            <span class="user-role"><%= SitioBase.Session.UsuarioPerfiles() %></span>
                            <div class="dropdown-menu user-pro-dropdown">
                                <!-- item-->
                                <div class="dropdown-header noti-title">
                                    <h6 class="text-overflow m-0">Bienvenido !</h6>
                                </div>

                                <!-- item-->
                                <a href='<%=ResolveUrl("~/View/Comun/MiCuenta/MiCuenta.aspx") %>' class="dropdown-item notify-item">
                                    <i class="mdi mdi-account-outline mr-1"></i>
                                    <span>Mi Cuenta</span>
                                </a>
                            </div>
                        </div>
                        <asp:LinkButton ID="lnkCerrarSession2" runat="server" OnClick="lnkCerrarSession_Click" CssClass="user-logout" ToolTip="Cerrar Sesion">
                            <i class="mdi mdi-logout"></i>
                        </asp:LinkButton>
                    </div>

                    <div class="clearfix"></div>

                </div>
                <!-- Sidebar -left -->

            </div>
            <!-- Left Sidebar End -->
            <!-- ============================================================== -->
            <!-- Start Page Content here -->
            <!-- ============================================================== -->

            <div class="content-page">
                <div class="content">
                    <div class="container-fluid">

                        <%-- Aviso de suscripcion (ANEXO F §6.6 · HU-193).
                             Por vencer y en gracia se avisan; vencida no
                             llega hasta aqui, porque SuscripcionAcceso.Exigir()
                             ya redirigio a la pagina de renovacion. --%>
                        <asp:Panel ID="pnlAvisoSuscripcion" runat="server" Visible="false" CssClass="sg-aviso-suscripcion">
                            <i class="mdi mdi-calendar-alert"></i>
                            <span><asp:Literal ID="litAvisoSuscripcion" runat="server" /></span>
                            <asp:HyperLink ID="lnkVerSuscripcion" runat="server" NavigateUrl="~/Renovar.aspx">Ver mi suscripción</asp:HyperLink>
                        </asp:Panel>

                        <!-- Encabezado de la pagina.
                             cphTitulo bajo aqui desde la topbar: en el diseño
                             aprobado la barra superior solo lleva buscador,
                             avisos y accion principal. cphSubtitulo y
                             cphEyebrow son opcionales; la pagina que no los
                             define simplemente no los muestra. -->
                        <div class="sg-page-head">
                            <asp:ContentPlaceHolder ID="cphEyebrow" runat="server">
                            </asp:ContentPlaceHolder>
                            <h1>
                                <asp:ContentPlaceHolder ID="cphTitulo" runat="server">
                                </asp:ContentPlaceHolder>
                            </h1>
                            <asp:ContentPlaceHolder ID="cphSubtitulo" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>

                        <!--Incio Selección de Cliente (fuera de UpdatePanel: postback completo) -->
                        <asp:ContentPlaceHolder ID="cphComboCliente" runat="server">
                        </asp:ContentPlaceHolder>
                        <!--Fin Selección de Cliente -->
                        <!--Incio Filtros -->
                        <asp:UpdatePanel runat="server" ID="UpdatePanel1" UpdateMode="Conditional">
                            <ContentTemplate>
                                <asp:ContentPlaceHolder ID="cphFiltro" runat="server">
                                </asp:ContentPlaceHolder>
                            </ContentTemplate>
                        </asp:UpdatePanel>
                        <!--Fin Filtros -->
                        <!-- Start Content-->
                        <div class="row card-box">
                            <div class="table-responsive">
                                <asp:UpdatePanel runat="server" ID="UpdatePanel2" UpdateMode="Conditional">
                                    <ContentTemplate>
                                        <asp:ContentPlaceHolder ID="cphBody" runat="server">
                                        </asp:ContentPlaceHolder>
                                    </ContentTemplate>
                                </asp:UpdatePanel>
                            </div>
                            <!-- container -->
                        </div>
                    </div>
                </div>
                <!-- content -->
            </div>
        </div>

        <!-- Scripts -->
        <div>
            <script type="text/javascript">
                var ModalProgress = 'ctl00_ModalProgress';
            </script>

            <!-- Vendor js -->
            <script src='<%=ResolveUrl("~/Css/Adminto/assets/js/vendor.min.js") %>'></script>

            <!-- knob plugin -->
            <script src='<%=ResolveUrl("~/Css/Adminto/assets/libs/jquery-knob/jquery.knob.min.js") %>'></script>

            <!-- App js -->
            <script src='<%=ResolveUrl("~/Css/Adminto/assets/js/app.min.js") %>'></script>

            <!-- El breadcrumb de la topbar se retiro junto con el titulo:
                 en el diseño aprobado la barra superior solo lleva buscador,
                 avisos y accion principal. El script que lo llenaba apuntaba
                 a spnBreadcrumbModulo y spnBreadcrumbSeccion, que ya no
                 existen, asi que se elimino con ellos. -->

            <!-- Marca en el sidebar el menu de la pagina actual, que es lo
                 que Adminto no resuelve por si solo cuando el arbol viene
                 de base de datos. -->
            <script type="text/javascript">
                $(function () {
                    var actual = window.location.pathname.toLowerCase();

                    $('#side-menu a[href]').each(function () {
                        var href = ($(this).attr('href') || '').toLowerCase();
                        if (href && href !== '#' && href.indexOf('javascript:') !== 0 && actual.indexOf(href) !== -1) {
                            $(this).addClass('active');
                            $(this).parents('li').addClass('mm-active');
                        }
                    });
                });
            </script>

            <%-- Modal propio SIGMA. Las fichas siguen siendo paginas WebForms,
                 pero el marco, el responsive y el ciclo de vida ya no dependen
                 de RadWindow. Debe cargarse antes de las aperturas de cada vista. --%>
            <script type="text/javascript" src="<%=ResolveUrl("~/Js/gsap/gsap.min.js") %>"></script>
            <script type="text/javascript" src="<%=ResolveUrl("~/Js/sigma-dialog.js") %>?vrs=9"></script>
            <script type="text/javascript" src="<%=ResolveUrl("~/Js/sigma-notificaciones-panel.js") %>?vrs=4"></script>
            <script type="text/javascript" src="<%=ResolveUrl("~/Js/sigma-calendario.js") %>?vrs=5"></script>

            <%-- Mejora progresiva de las vistas maestras: conserva RadGrid,
                 filtros, permisos y postbacks; agrega la lectura en drawer. --%>
            <script type="text/javascript" src="<%=ResolveUrl("~/Js/sigma-listas.js") %>?vrs=16"></script>

            <asp:ContentPlaceHolder ID="chpScript" runat="server">
            </asp:ContentPlaceHolder>
          
        </div>
    </form>
</body>
</html>
