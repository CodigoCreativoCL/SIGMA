<%@ Master Language="C#" CodeFile="Simple.master.cs" Inherits="Master_Simple" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <!-- Required meta tags -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <title></title>

    <!-- Bootstrap Css -->
    <link href="../Css/Adminto/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />

    <!-- Icons Css -->
    <link href="../Css/Adminto/assets/css/icons.min.css" rel="stylesheet" type="text/css" />

    <!-- App Css-->
    <link href="../Css/Adminto/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <!-- AjaxProgress CSS -->
    <link href="../Css/AjaxProgress/cssUpdateProgress.css" rel="stylesheet" />
    <link href="../Css/AjaxProgress/UpdateProgress.css?vrs=2" rel="stylesheet" />

    <!-- Default CSS -->
    <link href="../Css/Default/Default.css?vrs=3" rel="stylesheet" />
    
    <!-- LookAndFeel CSS -->
    <link href="../Css/LookAndFeel/Default.css?vrs=1" rel="stylesheet" />

    <!-- LookAndFeel v2 (Relook colores) -->
    <link href="../Css/LookAndFeel/v2/01-Variables.css?vrs=1" rel="stylesheet" />
    <link href="../Css/LookAndFeel/v2/02-Sidebar.css?vrs=1" rel="stylesheet" />
    <link href="../Css/LookAndFeel/v2/03-Botones.css?vrs=1" rel="stylesheet" />
    <link href="../Css/LookAndFeel/v2/04-Grid.css?vrs=1" rel="stylesheet" />
    <link href="../Css/LookAndFeel/v2/05-Telerik.css?vrs=1" rel="stylesheet" />
    <link href="../Css/LookAndFeel/v2/06-General.css?vrs=1" rel="stylesheet" />
    <link href="../Css/LookAndFeel/v2/07-Topbar.css?vrs=1" rel="stylesheet" />

    <!-- Material Design Icons 7.4.47, completo y fuera de Adminto.
         El icons.min.css de Adminto declara la familia "Material Design
         Icons" pero NO trae ni un glifo: solo los modificadores
         (mdi-rotate-*, mdi-dark). Con eso, TODO icono mdi del sitio salia
         vacio -no roto, vacio- y parecia un problema de permisos o de
         datos. Este archivo trae los 7.448 y va DESPUES de icons.min.css
         para que su @font-face gane. -->
    <link href="../Css/LookAndFeel/mdi/css/materialdesignicons.min.css?vrs=7" rel="stylesheet" />

    <!-- Marca SIGMA.
         Este master es el de TODOS los modales y no cargaba ni los tokens
         ni los componentes: cualquier clase de marca usada dentro de una
         ficha no aplicaba, y las fichas se veian con el look heredado
         mientras el resto del sitio ya estaba relookeado. Va DESPUES de v2
         para que los tokens de marca ganen. -->
    <link href="../Css/LookAndFeel/sigma-brand.css?vrs=3" rel="stylesheet" />
    <link href="../Css/LookAndFeel/sigma-components.css?vrs=11" rel="stylesheet" />
    <link href="../Css/LookAndFeel/sigma-avatares.css?vrs=2" rel="stylesheet" />
    <link href="../Css/LookAndFeel/sigma-modal.css?vrs=8" rel="stylesheet" />

    <!-- Telerik CSS -->
    <link href="../Css/UI/Telerik/Bootstrap/Grid.css?vrs=4" rel="stylesheet" />
    <link href="../Css/UI/Telerik/Bootstrap/RadComboBox.css?vrs=1" rel="stylesheet" />

    <!-- WebControls CSS -->
    <link href="../Css/UI/WebControls/calendar/CSS/Classic.css?vrs=1" rel="stylesheet" />
    <link href="../Css/UI/WebControls/Button.css?vrs=2" rel="stylesheet" />
    <link href="../Css/UI/WebControls/TextBox.css?vrs=1" rel="stylesheet" />
    <link href="../Css/UI/WebControls/CheckBox.css?vrs=1" rel="stylesheet" />

    <!-- SweetAlert CSS -->
    <link href="../Css/LookAndFeel/sigma-dialog.css?vrs=8" rel="stylesheet" />
    <link href="../Css/SweetAlert/sweetalert.css?vrs=2" rel="stylesheet" />
    <link href="../Css/SweetAlert/sweetalert2.min.css?vrs=2" rel="stylesheet" />
    <%-- Los botones del sitio. Va DESPUES de todas las demas: redefine
         reglas de Grid.css y Button.css que traen !important, y para
         ganarles hay que cargarla al final. --%>
    <link href="../Css/LookAndFeel/sigma-botones.css?vrs=16" rel="stylesheet" />
    <%-- El calendario de SIGMA: reemplaza el panel de PopCalendar. --%>
    <link href="../Css/LookAndFeel/sigma-calendario.css?vrs=3" rel="stylesheet" />

    <asp:ContentPlaceHolder ID="cphHeder" runat="server">
        <style>
            /* Forzar que los botones (Maximizar/Cerrar, etc.) siempre queden en una sola fila,
       sin depender del float/list-style del skin base embebido en Telerik.Web.UI */
            .RadWindow_Bootstrap .rwControlButtons,
            .RadWindow_Bootstrap .rwTable .rwControlButtons {
                display: flex !important;
                flex-flow: row nowrap !important;
                align-items: center;
                list-style: none;
                white-space: nowrap;
            }

                .RadWindow_Bootstrap .rwControlButtons li,
                .RadWindow_Bootstrap .rwTable .rwControlButtons li {
                    display: inline-block !important;
                    float: none !important;
                    flex: 0 0 auto;
                }
        </style>
    </asp:ContentPlaceHolder>
</head>
<%-- La clase sigma-modal-host era el gancho de la capa de compatibilidad
     que adaptaba el markup heredado. Esa capa se retiro el 30-08-2026, con
     las 20 fichas ya migradas a las clases .sigma-modal-* explicitas, asi
     que el gancho no engancha nada y se va con ella. --%>
<body style="background-color: white;">
    <form id="form1" runat="server" style="height: 100%; margin: 0px">
        <div>
            <!--Inicio ScriptManager-->
            <div>
                <asp:ScriptManager ID="ScriptManager1" runat="server" EnablePageMethods="true" AsyncPostBackTimeout="3600"
                    EnableScriptGlobalization="true" EnableScriptLocalization="true">
                    <Scripts>
                        <%-- Mismo arreglo que en Default.master: jQuery UI es
                             un plugin de jQuery y estaba declarado antes,
                             asi que fallaba con "jQuery is not defined". Este
                             master es el de todos los formularios modales, de
                             modo que el error salia en cada uno. --%>
                        <asp:ScriptReference Path="~/Js/jquery-1.9.1.js" />
                        <%-- $.browser, que jQuery 1.9 quito y jQuery UI 1.8 usa. Tiene
                             que ir ENTRE los dos. --%>
                        <asp:ScriptReference Path="~/Js/jquery-browser-shim.js" />
                        <asp:ScriptReference Path="~/Js/jquery-ui-1.8rc3.custom.min.js" />
                        <asp:ScriptReference Path="~/Js/Library.js?vrs=8" />
                        <%-- Define `.modal()`, que ClientAlert necesita y Bootstrap JS no
                             esta para dar. Va DESPUES de Library.js, que es quien lo usa. --%>
                        <asp:ScriptReference Path="~/Js/sigma-alerta-modal.js" />
                        <asp:ScriptReference Path="~/Js/sigma-popover.js?vrs=1" />
                        <asp:ScriptReference Path="~/Js/highcharts/highcharts.js" />
                        <asp:ScriptReference Path="~/Js/highcharts/highchartTable-min.js" />
                        <asp:ScriptReference Path="~/Css/AjaxProgress/jsUpdateProgress.js" />
                        <asp:ScriptReference Path="~/Css/UI/WebControls/calendar/PopCalendarFunctionsAjaxNet.js" />
                        <%-- El modal de SIGMA. Va tambien en este master porque una ficha
                             que ya esta DENTRO de un modal puede abrir otro —la carga
                             masiva de usuarios lo hace—, y el componente soporta
                             instancias anidadas. Sin esto, esa llamada revienta con
                             "SigmaModal is not defined". --%>
                        <asp:ScriptReference Path="~/Js/sigma-dialog.js?vrs=2" />
                        <%-- GSAP va ANTES del calendario: el componente
                             comprueba `window.gsap` y si no esta, se abre sin
                             animacion. En los modales quedaba sin ella. --%>
                        <asp:ScriptReference Path="~/Js/gsap/gsap.min.js" />
                        <asp:ScriptReference Path="~/Js/sigma-calendario.js" />
                        <asp:ScriptReference Path="~/Css/SweetAlert/sweetalert2.min.js" />
                    </Scripts>
                </asp:ScriptManager>
                <!--Inicio AjaxProgress-->
                <asp:Panel ID="panelUpdateProgress" runat="server" CssClass="updateProgress">
                    <asp:UpdateProgress ID="UpdateProg1" DisplayAfter="0" runat="server">
                        <ProgressTemplate>
                            <div class="up-card">
                                <div class="up-brand-stage" aria-hidden="true">
                                    <svg class="up-vector-trails" viewBox="0 0 160 150">
                                        <path d="M52 124C38 96 68 87 57 57C51 41 58 25 71 13" />
                                        <path d="M82 128C68 102 92 89 83 65C77 48 85 31 97 18" />
                                        <path d="M108 123C98 101 121 91 113 69C107 52 116 40 126 30" />
                                    </svg>
                                    <span class="up-particle is-1"></span><span class="up-particle is-2"></span>
                                    <span class="up-particle is-3"></span><span class="up-particle is-4"></span>
                                    <span class="up-particle is-5"></span><span class="up-particle is-6"></span>
                                    <img class="up-logo" src="<%=ResolveUrl("~/Imagen/sigma-isotipo-gradient.svg") %>" alt="" />
                                </div>
                                <div class="up-text-area">
                                    <span class="up-label-caps">PROCESANDO EN SIGMA</span>
                                    <div class="up-timer">
                                        Tiempo transcurrido:
                                        <span class="up-bold">
                                            <label id="lblModalMinutos">0</label>
                                            Minutos</span>
                                        <span class="up-bold">
                                            <label id="lblModalSegundos">0</label>
                                            Segundos</span>
                                    </div>
                                </div>
                                <div class="up-progress-track">
                                    <div class="up-progress-fill"></div>
                                </div>
                            </div>
                        </ProgressTemplate>
                    </asp:UpdateProgress>
                </asp:Panel>
                <ajaxToolkit:ModalPopupExtender ID="ModalProgress" runat="server" TargetControlID="panelUpdateProgress"
                    BackgroundCssClass="modalBackground" PopupControlID="panelUpdateProgress" />
                <!--Fin AjaxProgress-->
            </div>
            <!--Fin ScriptManager-->

            <!--Inicio Body-->
            <div class="container-fluid">
                <asp:UpdatePanel runat="server" ID="UpdatePanel2" UpdateMode="Conditional">
                    <ContentTemplate>
                        <asp:ContentPlaceHolder ID="cphBody" runat="server">
                        </asp:ContentPlaceHolder>
                    </ContentTemplate>
                </asp:UpdatePanel>
            </div>
            <!--Fin Body-->

            <!--Inicio Script-->
            <div>
                <script type="text/javascript" language="javascript">
                    var ModalProgress = 'ctl00_ModalProgress';

                    function getRadWindowSimple() {
                        var oWindow = null;
                        if (window.radWindow)
                            oWindow = window.radWindow;
                        else if (window.frameElement.radWindow)
                            oWindow = window.frameElement.radWindow;
                        return oWindow;
                    }

                    function closeWindowSimple() {
                        var window = getRadWindowSimple();
                        if (window.BrowserWindow.LogOut) window.BrowserWindow.LogOut();
                        window.close();
                    }

                </script>

                <!-- Vendor js -->
                <script src='<%=ResolveUrl("~/Css/Adminto/assets/js/vendor.min.js") %>'></script>




                <asp:ContentPlaceHolder ID="chpScript" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <!--Fin Script-->
        </div>
    </form>
</body>
</html>
