<?xml version="1.0"?>
<!-- Copia este archivo como secretos.local.config (ignorado por git) y completa la clave.
     En produccion los mismos valores van en el secreto INTRANET_APPSETTINGS_JSON:
     {"SmtpHost":"mail.codigocreativo.tech","SmtpPuerto":"587","SmtpUsuario":"noreply@codigocreativo.tech","SmtpClave":"...","SmtpSsl":"true"} -->
<appSettings>
  <add key="SmtpHost" value="mail.codigocreativo.tech" />
  <add key="SmtpPuerto" value="587" />
  <add key="SmtpUsuario" value="noreply@codigocreativo.tech" />
  <add key="SmtpClave" value="" />
  <add key="SmtpSsl" value="true" />
  <!-- Webpay Plus. INTEGRACION = modo de prueba (credenciales publicas de transbankdevelopers.cl). -->
  <add key="WebpayAmbiente" value="INTEGRACION" />
  <add key="WebpayCodigoComercio" value="" />
  <add key="WebpayApiKey" value="" />
  <!-- Clave de Jobs.aspx (la usa la tarea programada de Plesk). -->
  <add key="JobsClave" value="" />
</appSettings>
