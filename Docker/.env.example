# =============================================================================
# SIGMA · variables de entorno de los contenedores
#
# Copiar este archivo como .env y completarlo. El .env NO se versiona: lleva
# credenciales reales. Este ejemplo solo describe que va en cada variable.
#
#   cp .env.example .env
#   docker compose up -d --build
# =============================================================================

# ----------------------------------------------------------------- puertos
PUERTO_INTRANET=8080
PUERTO_API=8081

# ------------------------------------------------------------- obligatorias
# Sin estas dos el contenedor no arranca, y es a proposito: un sitio que
# levanta con la configuracion a medias falla recien cuando alguien entra.

# Base de datos. Apunta donde corresponda segun el ambiente.
SIGMA_DB_CONNECTION=Data Source=SERVIDOR;Initial Catalog=BASE;User Id=USUARIO;Password=CLAVE;Encrypt=True;TrustServerCertificate=True;

# Firma de los tokens de la API. Sin valor por defecto a proposito: una firma
# por defecto significa que cualquiera que conozca el proyecto puede emitir un
# token valido contra cualquier despliegue. Usar una cadena larga y aleatoria,
# distinta en cada ambiente.
SIGMA_JWT_SECRET=

# ----------------------------------------------------------------- sesion
SIGMA_JWT_EXPIRE_MINUTES=480
SIGMA_JWT_AUDIENCE=
SIGMA_JWT_ISSUER=

# Clave con la que la Intranet se identifica ante la API para las operaciones
# de servicio (archivos y SIGMA AI). Debe ser la MISMA en los dos servicios.
SIGMA_API_KEY=

# --------------------------------------------------------------- intranet
SIGMA_AMBIENTE=Contenedor
SIGMA_URL_SITIO=http://localhost:8080
SIGMA_CRYPTO_KEY=
SIGMA_GOOGLE_MAPS_KEY=
SIGMA_CORREO_REMITENTE=
SIGMA_CORREO_REMITENTE_NOMBRE=SIGMA
SIGMA_PDF_URL=

# Dentro de la red de compose la Intranet llega a la API por el nombre del
# servicio. No usar localhost: dentro del contenedor, localhost es el propio
# contenedor.
SIGMA_API_URL=http://api/
SIGMA_ALMACENAMIENTO_URL=http://api/
SIGMA_ALMACENAMIENTO_KEY=
SIGMA_ALMACENAMIENTO_CONTENEDOR=

# ------------------------------------------------- Azure Blob Storage (API)
# Si se dejan vacias, el sistema funciona pero las subidas de archivos fallan.
SIGMA_BLOB_ENDPOINT=
SIGMA_BLOB_SAS=
SIGMA_BLOB_CONTENEDOR=

# ------------------------------------------ Azure Machine Learning (SIGMA AI)
# Solo para el registro de modelos y corridas. Si se dejan vacias, SIGMA AI
# funciona igual: el entrenamiento y la puntuacion ocurren dentro de la API
# (ver ADR-01 del Documento de Diseno), y esto es nada mas la trazabilidad.
SIGMA_AML_TENANT=
SIGMA_AML_CLIENT_ID=
SIGMA_AML_CLIENT_SECRET=
SIGMA_AML_SUBSCRIPTION=
SIGMA_AML_RESOURCE_GROUP=
SIGMA_AML_WORKSPACE=
SIGMA_AML_REGION=
SIGMA_AML_CONTENEDOR=

# --------------------------------------------- Azure Custom Vision (opcional)
SIGMA_CV_ENDPOINT=
SIGMA_CV_KEY=
SIGMA_CV_PROJECT=
SIGMA_CV_ITERATION=
